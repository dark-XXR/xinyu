JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
JWT_ISSUER=love-reply-api
ADMIN_JWT_SIGNING_KEY=replace-with-a-distinct-32-byte-random-secret
DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
AUDIT_INTEGRITY_KEY=replace-with-a-distinct-32-byte-random-secret
ADMIN_BOOTSTRAP_LOGIN_NAME=owner@example.invalid
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-initial-password
ADMIN_BOOTSTRAP_TOTP_SECRET=replace-with-a-base32-totp-secret
ADMIN_BOOTSTRAP_DISPLAY_NAME=Platform Owner
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=love_reply_dev
OBJECT_STORAGE_SECRET_KEY=replace_for_non_local_use
